@model IEnumerable<BibliothequeApp.Models.Reservation>
@{
    ViewData["Title"] = "Réservations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-bookmark-check me-2"></i>Réservations</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle réservation</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>ID</th><th>Livre</th><th>Membre</th><th>Date réservation</th><th>Date expiration</th><th>Statut</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><code>@r.Id_reservation</code></td>
                    <td>@r.Livre?.Titre</td>
                    <td>@r.Membre?.Nom @r.Membre?.Prenom</td>
                    <td>@r.Date_reservation</td>
                    <td>@r.Date_expiration</td>
                    <td>
                        @{
                            var badgeR = r.Statut switch
                            {
                                "Active" => "bg-success",
                                "Expirée" => "bg-secondary",
                                "Annulée" => "bg-danger",
                                _ => "bg-info"
                            };
                        }
                        <span class="badge @badgeR">@r.Statut</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@r.Id_reservation" class="btn btn-sm btn-outline-info me-1"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@r.Id_reservation" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@r.Id_reservation" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Aucune réservation.</td></tr>
            }
        </tbody>
    </table>
</div>
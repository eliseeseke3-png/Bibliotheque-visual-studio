@model BibliothequeApp.Models.Reservation
@{
    ViewData["Title"] = "Modifier réservation";
}

<h2 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Modifier la réservation</h2>
<div class="card shadow-sm" style="max-width:560px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input asp-for="Id_reservation" type="hidden" />
            <div class="mb-3">
                <label class="form-label">ID</label>
                <input value="@Model.Id_reservation" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Id_membre" class="form-label">Membre</label>
                <select asp-for="Id_membre" class="form-select">
                    @foreach (var m in ViewBag.Membres as List<BibliothequeApp.Models.Membre> ?? new())
                    {
                        <option value="@m.Id_membre">@m.Nom @m.Prenom</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Id_livre" class="form-label">Livre</label>
                <select asp-for="Id_livre" class="form-select">
                    @foreach (var l in ViewBag.Livres as List<BibliothequeApp.Models.Livre> ?? new())
                    {
                        <option value="@l.Id_livre">@l.Titre</option>
                    }
                </select>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="Date_reservation" class="form-label">Date réservation</label>
                    <input asp-for="Date_reservation" type="date" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label asp-for="Date_expiration" class="form-label">Date expiration</label>
                    <input asp-for="Date_expiration" type="date" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Statut" class="form-label">Statut</label>
                <select asp-for="Statut" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Expirée">Expirée</option>
                    <option value="Annulée">Annulée</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Mettre à jour</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
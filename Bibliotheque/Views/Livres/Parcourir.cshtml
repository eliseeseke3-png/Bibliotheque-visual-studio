@model List<BibliothequeApp.Models.Livre>

@{
    ViewData["Title"] = "Parcourir les Livres";
}

<div class="container-fluid py-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-4">📚 Parcourir les Livres</h1>

            <form method="get" action="@Url.Action("Parcourir", "Livres")" class="mb-4">
                <div class="input-group input-group-lg">
                    <input type="text" name="searchTitle" class="form-control" placeholder="Rechercher un titre..." value="@ViewData["searchTitle"]" />
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info alert-lg text-center" role="alert">
            <h4>Aucun livre trouvé</h4>
            <p>Essayez une autre recherche ou parcourez tous les livres disponibles.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var livre in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm hover-shadow transition">
                        <!-- Image du livre -->
                        <div class="position-relative" style="height: 250px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(livre.ImageUrl))
                            {
                                <img src="@livre.ImageUrl" alt="@livre.Titre" class="card-img-top h-100" style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center h-100">
                                    <span class="text-center">
                                        <i class="bi bi-book" style="font-size: 3rem;"></i>
                                        <br />
                                        Pas d'image
                                    </span>
                                </div>
                            }

                            <!-- Badge de disponibilité -->
                            @if (livre.Disponibilite == "Disponible")
                            {
                                <span class="position-absolute top-0 end-0 badge bg-success m-2">
                                    <i class="bi bi-check-circle"></i> Disponible
                                </span>
                            }
                            else
                            {
                                <span class="position-absolute top-0 end-0 badge bg-danger m-2">
                                    <i class="bi bi-x-circle"></i> Indisponible
                                </span>
                            }
                        </div>

                        <!-- Contenu de la carte -->
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate" title="@livre.Titre">@livre.Titre</h5>
                            <p class="card-text text-muted small">
                                <i class="bi bi-person"></i> @livre.Auteur
                            </p>
                            <p class="card-text small">
                                <span class="badge bg-info">@livre.Categorie</span>
                            </p>
                            <p class="card-text flex-grow-1 small">
                                @if (!string.IsNullOrEmpty(livre.Description))
                                {
                                    <span class="text-truncate" title="@livre.Description">
                                        @livre.Description
                                    </span>
                                }
                            </p>

                            <!-- Informations de stock -->
                            <div class="mb-3">
                                <small class="text-secondary">
                                    <i class="bi bi-stack"></i>
                                    @livre.QuantiteDisponible/@livre.Quantite exemplaires disponibles
                                </small>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="card-footer bg-light border-0">
                            <div class="d-grid gap-2">
                                <a href="@Url.Action("Details", "Livres", new { id = livre.Id_livre })" class="btn btn-primary btn-sm">
                                    <i class="bi bi-eye"></i> Détails
                                </a>
                                @if (livre.QuantiteDisponible > 0)
                                {
                                    <a href="@Url.Action("Create", "Reservations", new { livreId = livre.Id_livre })" class="btn btn-success btn-sm">
                                        <i class="bi bi-calendar-check"></i> Réserver
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease;
    }

    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .transition {
        transition: all 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }
</style>

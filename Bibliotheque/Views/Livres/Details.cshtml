@model BibliothequeApp.Models.Livre

@{
    ViewData["Title"] = "Détails du Livre";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Titre" class="img-fluid rounded shadow" style="max-height: 400px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center" style="height: 400px;">
                    <span>Pas d'image disponible</span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <h1 class="mb-3">@Model.Titre</h1>

            <div class="mb-3">
                <h5 class="text-muted">@Model.Auteur</h5>
            </div>

            <div class="mb-3">
                <p><strong>Catégorie :</strong> <span class="badge bg-primary">@Model.Categorie</span></p>
                <p><strong>ISBN :</strong> @Model.ISBN</p>
                <p><strong>Quantité disponible :</strong> <span class="badge bg-info">@Model.QuantiteDisponible / @Model.Quantite</span></p>
                <p>
                    <strong>Disponibilité :</strong>
                    @if (Model.Disponibilite == "Disponible")
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Non disponible</span>
                    }
                </p>
            </div>

            <div class="mb-4">
                <h5>Description</h5>
                <p class="lead">@Model.Description</p>
            </div>

            <div class="d-flex gap-2">
                @if (Model.QuantiteDisponible > 0)
                {
                    <a href="@Url.Action("Create", "Reservations", new { livreId = Model.Id_livre })" class="btn btn-primary btn-lg">
                        <i class="bi bi-calendar-check"></i> Réserver ce livre
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg" disabled>
                        <i class="bi bi-calendar-x"></i> Indisponible
                    </button>
                }

                @if (User.IsInRole("Administrateur"))
                {
                    <a href="@Url.Action("Edit", "Livres", new { id = Model.Id_livre })" class="btn btn-warning btn-lg">
                        <i class="bi bi-pencil"></i> Modifier
                    </a>
                    <a href="@Url.Action("Delete", "Livres", new { id = Model.Id_livre })" class="btn btn-danger btn-lg">
                        <i class="bi bi-trash"></i> Supprimer
                    </a>
                }

                <a href="@Url.Action("Parcourir", "Livres")" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>
        </div>
    </div>
</div>

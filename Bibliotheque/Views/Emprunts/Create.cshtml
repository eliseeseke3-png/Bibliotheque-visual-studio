@model BibliothequeApp.Models.Emprunt
@{
    ViewData["Title"] = "Nouvel emprunt";
}

<h2 class="mb-4"><i class="bi bi-plus-circle me-2"></i>Nouvel emprunt</h2>
<div class="card shadow-sm" style="max-width:580px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Id_emprunt" class="form-label">Identifiant emprunt</label>
                <input asp-for="Id_emprunt" class="form-control" placeholder="EMP001" />
            </div>
            <div class="mb-3">
                <label asp-for="Id_membre" class="form-label">Membre</label>
                <select asp-for="Id_membre" class="form-select">
                    <option value="">— Sélectionner un membre —</option>
                    @foreach (var m in ViewBag.Membres as List<BibliothequeApp.Models.Membre> ?? new())
                    {
                        <option value="@m.Id_membre">@m.Nom @m.Prenom</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Id_livre" class="form-label">Livre</label>
                <select asp-for="Id_livre" class="form-select">
                    <option value="">— Sélectionner un livre disponible —</option>
                    @foreach (var l in ViewBag.Livres as List<BibliothequeApp.Models.Livre> ?? new())
                    {
                        <option value="@l.Id_livre">@l.Titre — @l.Auteur</option>
                    }
                </select>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="Date_emprunt" class="form-label">Date d'emprunt</label>
                    <input asp-for="Date_emprunt" type="date" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label asp-for="Date_retour_prevue" class="form-label">Retour prévu</label>
                    <input asp-for="Date_retour_prevue" type="date" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Statut" class="form-label">Statut</label>
                <select asp-for="Statut" class="form-select">
                    <option value="En cours">En cours</option>
                    <option value="Retourné">Retourné</option>
                    <option value="En retard">En retard</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Enregistrer</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
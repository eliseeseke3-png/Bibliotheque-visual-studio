@model IEnumerable<BibliothequeApp.Models.Emprunt>
@{
    ViewData["Title"] = "Emprunts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-arrow-left-right me-2"></i>Emprunts</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvel emprunt</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>ID</th><th>Livre</th><th>Membre</th><th>Date emprunt</th><th>Retour prévu</th><th>Retour effectif</th><th>Statut</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td><code>@e.Id_emprunt</code></td>
                    <td>@e.Livre?.Titre</td>
                    <td>@e.Membre?.Nom @e.Membre?.Prenom</td>
                    <td>@(e.Date_emprunt.ToString("dd/MM/yyyy"))</td>
                    <td>@(e.Date_retour_prevue.ToString("dd/MM/yyyy"))</td>
                    <td>@(e.Date_retour_effective.HasValue ? e.Date_retour_effective.Value.ToString("dd/MM/yyyy") : "—")</td>
                    <td>
                        @{
                            var badgeClass = e.Statut switch
                            {
                                "En cours" => "bg-warning text-dark",
                                "Retourné" => "bg-success",
                                "En retard" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@e.Statut</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@e.Id_emprunt" class="btn btn-sm btn-outline-info me-1"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@e.Id_emprunt" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@e.Id_emprunt" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">Aucun emprunt enregistré.</td></tr>
            }
        </tbody>
    </table>
</div>
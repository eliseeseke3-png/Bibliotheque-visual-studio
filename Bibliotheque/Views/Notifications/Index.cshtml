@model IEnumerable<BibliothequeApp.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var notificationsList = Model?.OrderByDescending(n => n.Date_envoie).ToList() ?? new List<BibliothequeApp.Models.Notification>();
    var unreadCount = notificationsList.Count(n => !n.Lu);

    string GetNotificationColor(string type)
    {
        return type switch
        {
            "Système" => "#4F46E5",
            "Messages" => "#7C3AED",
            "Emprunts" => "#10B981",
            _ => "#6B7280"
        };
    }

    string GetBadgeClass(string type)
    {
        return type switch
        {
            "Système" => "bg-info",
            "Messages" => "bg-warning",
            "Emprunts" => "bg-success",
            _ => "bg-secondary"
        };
    }

    string GetNotificationIcon(string type)
    {
        return type switch
        {
            "Système" => "bi-gear",
            "Messages" => "bi-chat-dots",
            "Emprunts" => "bi-book",
            _ => "bi-bell"
        };
    }

    string GetRelativeTime(DateTime date)
    {
        var now = DateTime.Now;
        var diff = now - date;

        return diff.TotalMinutes < 1 ? "À l'instant"
            : diff.TotalMinutes < 60 ? $"Il y a {(int)diff.TotalMinutes}m"
            : diff.TotalHours < 24 ? $"Il y a {(int)diff.TotalHours}h"
            : diff.TotalDays < 7 ? $"Il y a {(int)diff.TotalDays}j"
            : date.ToString("dd/MM/yyyy");
    }
}

<div class="row mb-5">
    <!-- Header avec bouton "Tout marquer comme lu" -->
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 fw-bold mb-0">
                    <i class="bi bi-bell me-2" style="color: #4F46E5;"></i>Notifications
                </h1>
                <p class="text-muted mt-2">
                    @if (unreadCount > 0)
                    {
                        <text>Vous avez @unreadCount notification(s) non lue(s)</text>
                    }
                    else
                    {
                        <text>Toutes vos notifications sont lues</text>
                    }
                </p>
            </div>
            @if (unreadCount > 0)
            {
                <button class="btn btn-outline-primary btn-sm rounded-pill" id="markAllRead">
                    <i class="bi bi-check-all me-1"></i>Tout marquer comme lu
                </button>
            }
        </div>
    </div>
</div>

<!-- Filtres -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-primary rounded-pill active filter-btn" data-filter="all">
                <i class="bi bi-funnel me-1"></i>Toutes
            </button>
            <button class="btn btn-sm btn-outline-primary rounded-pill filter-btn" data-filter="unread">
                <i class="bi bi-circle-fill me-1"></i>Non lues
            </button>
            <button class="btn btn-sm btn-outline-primary rounded-pill filter-btn" data-filter="Système">
                <i class="bi bi-gear me-1"></i>Système
            </button>
            <button class="btn btn-sm btn-outline-primary rounded-pill filter-btn" data-filter="Messages">
                <i class="bi bi-chat-dots me-1"></i>Messages
            </button>
        </div>
    </div>
</div>

<!-- Feed Notifications -->
<div class="row">
    <div class="col-lg-8">
        @if (notificationsList.Any())
        {
            @foreach (var notif in notificationsList)
            {
                var notifColor = GetNotificationColor(notif.Type);
                var badgeClass = GetBadgeClass(notif.Type);
                var iconClass = GetNotificationIcon(notif.Type);
                var relativeTime = GetRelativeTime(notif.Date_envoie ?? DateTime.MinValue);

                <div class="notification-card card mb-3 notification-item" 
                     data-type="@notif.Type" 
                     data-read="@notif.Lu.ToString().ToLower()"
                     style="border-left-color: @notifColor;">

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <!-- Type badge -->
                                <span class="badge @badgeClass mb-2">
                                    <i class="@iconClass me-1"></i>
                                    @notif.Type
                                </span>

                                <!-- Indicateur non-lu -->
                                @if (!notif.Lu)
                                {
                                    <span class="badge bg-light text-primary ms-2">
                                        <i class="bi bi-dot"></i> Nouvelle
                                    </span>
                                }

                                <!-- Message -->
                                <p class="card-text mt-2 mb-2 @(notif.Lu ? "text-muted" : "fw-600")">
                                    @notif.Message
                                </p>

                                <!-- Détails du membre -->
                                @if (notif.Membre != null)
                                {
                                    <small class="text-muted d-block mb-2">
                                        <i class="bi bi-person me-1"></i>
                                        @notif.Membre.Nom @notif.Membre.Prenom
                                    </small>
                                }

                                <!-- Timestamp relatif -->
                                <small class="text-muted">
                                    <i class="bi bi-clock-history me-1"></i>
                                    @relativeTime
                                </small>
                            </div>

                            <!-- Actions -->
                            <div class="dropdown ms-2">
                                <button class="btn btn-ghost" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (!notif.Lu)
                                    {
                                        <li><a class="dropdown-item mark-read-btn" href="#" data-id="@notif.Id_notification"><i class="bi bi-check me-2"></i>Marquer comme lu</a></li>
                                    }
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-pin me-2"></i>Épingler</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger delete-btn" href="#" data-id="@notif.Id_notification"><i class="bi bi-trash me-2"></i>Supprimer</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- État vide -->
            <div class="text-center py-5">
                <div class="mb-4">
                    <svg width="100" height="100" class="opacity-75" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" style="color: #D1D5DB;">
                        <path d="M8 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2 2 2 0 0 1 2 2v10a2 2 0 0 1-2 2zM0 8a.5.5 0 0 0 .5.5h1.653a.5.5 0 0 1 .429.237l.001.002.001.002.001.002.001.002A.5.5 0 0 0 3.1 9h1.306a.5.5 0 0 0 .429-.237.498.498 0 0 1 .001-.002l.001-.002.001-.002.001-.002A.5.5 0 0 0 4.906 8H3.1a.5.5 0 0 1-.429-.763.497.497 0 0 0 .001-.002l.001-.002.001-.002.001-.002A.5.5 0 0 1 3.653 4.5H2.347a.5.5 0 0 1-.429.237.498.498 0 0 0-.001.002l-.001.002-.001.002-.001.002A.5.5 0 0 1 .5 4.5H0a.5.5 0 0 0-.5.5zM12 8a.5.5 0 0 1 .5-.5h1.653a.5.5 0 0 0 .429-.237.498.498 0 0 1 .001.002l.001.002.001.002.001.002A.5.5 0 0 1 15.1 9h-1.306a.5.5 0 0 1-.429.763.497.497 0 0 0-.001.002l-.001.002-.001.002-.001.002A.5.5 0 0 0 12.906 8h1.8a.5.5 0 0 0 .429.237.498.498 0 0 1 .001.002l.001.002.001.002.001.002A.5.5 0 0 0 15.653 4.5h1.347a.5.5 0 0 1 .429-.237.498.498 0 0 0 .001-.002l.001-.002.001-.002.001-.002A.5.5 0 0 1 15.5 4.5h1a.5.5 0 0 1 .5.5z"/>
                    </svg>
                </div>
                <h4 class="mb-2 fw-bold">Aucune notification</h4>
                <p class="text-muted">Vous n'avez pas encore de notifications. Revenez plus tard !</p>
            </div>
        }
    </div>

    <!-- Sidebar d'infos (visible sur desktop) -->
    <div class="col-lg-4 d-none d-lg-block">
        <div class="card bg-light shadow-sm rounded-lg sticky-top" style="top: 20px;">
            <div class="card-body">
                <h5 class="card-title mb-3 fw-bold">
                    <i class="bi bi-info-circle me-2"></i>À propos
                </h5>
                <p class="text-muted small mb-3">Les notifications vous permettent de rester informé des mises à jour importantes concernant vos emprunts, réservations et le système.</p>

                <hr>

                <h6 class="mb-3 fw-bold">Types de notifications :</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <span class="badge bg-info me-2">
                            <i class="bi bi-gear"></i>
                        </span>
                        Système
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-warning me-2">
                            <i class="bi bi-chat-dots"></i>
                        </span>
                        Messages
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-success me-2">
                            <i class="bi bi-book"></i>
                        </span>
                        Emprunts
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filtrage des notifications
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const filter = this.getAttribute('data-filter');
                let visibleCount = 0;

                document.querySelectorAll('.notification-item').forEach(item => {
                    const type = item.getAttribute('data-type');
                    const isRead = item.getAttribute('data-read') === 'true';

                    let show = false;
                    if (filter === 'all') {
                        show = true;
                    } else if (filter === 'unread') {
                        show = !isRead;
                    } else {
                        show = type === filter;
                    }

                    item.style.display = show ? 'block' : 'none';
                    if (show) visibleCount++;
                });

                // Afficher message si aucun résultat
                if (visibleCount === 0) {
                    console.log('Aucune notification trouvée pour ce filtre');
                }

                // Activer le bouton
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Marquer comme lu (action)
        document.querySelectorAll('.mark-read-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                alert('Marquer comme lu - Implémentation Backend requise');
            });
        });

        // Supprimer (action)
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                if (confirm('Êtes-vous sûr de vouloir supprimer cette notification ?')) {
                    alert('Suppression - Implémentation Backend requise');
                }
            });
        });

        // Tout marquer comme lu
        const markAllBtn = document.getElementById('markAllRead');
        if (markAllBtn) {
            markAllBtn.addEventListener('click', function() {
                alert('Marquer tout comme lu - Implémentation Backend requise');
            });
        }
    </script>
}

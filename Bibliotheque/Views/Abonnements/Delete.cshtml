@model BibliothequeApp.Models.Abonnement
@{
    ViewData["Title"] = "Supprimer abonnement";
}

<h2 class="mb-4 text-danger"><i class="bi bi-trash me-2"></i>Supprimer l'abonnement</h2>
<div class="card border-danger shadow-sm" style="max-width:460px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-5">Code</dt>
            <dd class="col-sm-7">@Model.CodeAbonnement</dd>
            <dt class="col-sm-5">Membre</dt>
            <dd class="col-sm-7 fw-bold">@Model.Membre?.Nom @Model.Membre?.Prenom</dd>
            <dt class="col-sm-5">Montant</dt>
            <dd class="col-sm-7 text-danger fw-bold">@Model.Montant.ToString("N0") FCFA</dd>
            <dt class="col-sm-5">Statut</dt>
            <dd class="col-sm-7">@(Model.Actif ? "Actif" : "Inactif")</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Id_abonnement" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Confirmer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </form>
    </div>
</div>
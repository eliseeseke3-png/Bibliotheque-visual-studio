@model BibliothequeApp.Models.Abonnement
@{
    ViewData["Title"] = "Nouvel abonnement";
}

<h2 class="mb-4"><i class="bi bi-plus-circle me-2"></i>Nouvel abonnement</h2>
<div class="card shadow-sm" style="max-width:560px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="CodeAbonnement" class="form-label">Code d'abonnement</label>
                <input asp-for="CodeAbonnement" class="form-control" placeholder="ABO12345678" readonly />
                <small class="form-text text-muted">Généré automatiquement</small>
            </div>
            <div class="mb-3">
                <label asp-for="Id_membre" class="form-label">Membre</label>
                <select asp-for="Id_membre" asp-items="ViewBag.MembresSelect" class="form-select" required>
                    <option value="">— Sélectionner un membre —</option>
                </select>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="DateDebut" class="form-label">Date de début</label>
                    <input asp-for="DateDebut" type="date" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label asp-for="DateFin" class="form-label">Date de fin</label>
                    <input asp-for="DateFin" type="date" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Montant" class="form-label">Montant (FCFA)</label>
                <input asp-for="Montant" type="number" class="form-control" placeholder="5000" value="5000" />
            </div>
            <div class="mb-3">
                <label class="form-label">
                    <input asp-for="Actif" type="checkbox" />
                    Actif
                </label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Enregistrer</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

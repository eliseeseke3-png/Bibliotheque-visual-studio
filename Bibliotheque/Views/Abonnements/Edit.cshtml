@model BibliothequeApp.Models.Abonnement
@{
    ViewData["Title"] = "Modifier abonnement";
}

<h2 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Modifier l'abonnement</h2>
<div class="card shadow-sm" style="max-width:560px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input asp-for="Id_abonnement" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Code Abonnement</label>
                <input value="@Model.CodeAbonnement" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Id_membre" class="form-label">Membre</label>
                <select asp-for="Id_membre" class="form-select" required>
                    @foreach (var m in ViewBag.Membres as List<BibliothequeApp.Models.Membre> ?? new())
                    {
                        <option value="@m.Id_membre" selected="@(Model.Id_membre == m.Id_membre)">@m.Nom @m.Prenom</option>
                    }
                </select>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="DateDebut" class="form-label">Date de début</label>
                    <input asp-for="DateDebut" type="date" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label asp-for="DateFin" class="form-label">Date de fin</label>
                    <input asp-for="DateFin" type="date" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Montant" class="form-label">Montant (FCFA)</label>
                <input asp-for="Montant" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">
                    <input asp-for="Actif" type="checkbox" />
                    Actif
                </label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Mettre à jour</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
@model BibliothequeApp.Models.Penalite
@{
    ViewData["Title"] = "Supprimer pénalité";
}

<h2 class="mb-4 text-danger"><i class="bi bi-trash me-2"></i>Supprimer la pénalité</h2>
<div class="card border-danger shadow-sm" style="max-width:460px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-5">ID</dt>
            <dd class="col-sm-7">@Model.Id_penalite</dd>
            <dt class="col-sm-5">Montant</dt>
            <dd class="col-sm-7 fw-bold text-danger">@Model.Montant FCFA</dd>
            <dt class="col-sm-5">Statut</dt>
            <dd class="col-sm-7">@Model.Statut</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Id_penalite" />
            <button type="submit" class="btn btn-danger">Confirmer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </form>
    </div>
</div>


@model BibliothequeApp.Models.Penalite
@{
    ViewData["Title"] = "Nouvelle pénalité";
}

<h2 class="mb-4"><i class="bi bi-exclamation-circle me-2"></i>Nouvelle pénalité</h2>
<div class="card shadow-sm" style="max-width:520px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Id_penalite" class="form-label">Identifiant</label>
                <input asp-for="Id_penalite" class="form-control" placeholder="PEN001" />
            </div>
            <div class="mb-3">
                <label asp-for="Id_emprunt" class="form-label">Emprunt concerné</label>
                <select asp-for="Id_emprunt" class="form-select">
                    <option value="">— Sélectionner —</option>
                    @foreach (var e in ViewBag.Emprunts as List<BibliothequeApp.Models.Emprunt> ?? new())
                    {
                        <option value="@e.Id_emprunt">@e.Id_emprunt — @e.Membre?.Nom (@e.Livre?.Titre)</option>
                    }
                </select>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="Montant" class="form-label">Montant (FCFA)</label>
                    <input asp-for="Montant" type="number" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label asp-for="Date_penalite" class="form-label">Date</label>
                    <input asp-for="Date_penalite" type="date" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Statut" class="form-label">Statut</label>
                <select asp-for="Statut" class="form-select">
                    <option value="Impayée">Impayée</option>
                    <option value="Payée">Payée</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Motif" class="form-label">Motif</label>
                <textarea asp-for="Motif" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-save me-1"></i>Enregistrer</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
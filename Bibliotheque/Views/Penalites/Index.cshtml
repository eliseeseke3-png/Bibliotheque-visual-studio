@model IEnumerable<BibliothequeApp.Models.Penalite>
@{
    ViewData["Title"] = "Pénalités";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-exclamation-triangle me-2"></i>Pénalités</h2>
    @if (User.IsInRole("Administrateur"))
    {
        <a asp-action="Create" class="btn btn-danger"><i class="bi bi-plus-lg me-1"></i>Nouvelle pénalité</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>ID</th><th>Emprunt</th><th>Membre</th><th>Montant</th><th>Date</th><th>Statut</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><code>@p.Id_penalite</code></td>
                    <td><code>@p.Emprunt?.Id_emprunt</code></td>
                    <td>@p.Emprunt?.Membre?.Nom @p.Emprunt?.Membre?.Prenom</td>
                    <td class="fw-bold text-danger">@p.Montant FCFA</td>
                    <td>@p.Date_penalite</td>
                    <td>
                        <span class="badge @(p.Statut == "Payée" ? "bg-success" : "bg-danger")">@p.Statut</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@p.Id_penalite" class="btn btn-sm btn-outline-info me-1"><i class="bi bi-eye"></i></a>
                        @if (User.IsInRole("Administrateur"))
                        {
                            <a asp-action="Edit" asp-route-id="@p.Id_penalite" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.Id_penalite" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Aucune pénalité.</td></tr>
            }
        </tbody>
    </table>
</div>